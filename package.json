{
  "name": "duh-ipxact",
  "version": "1.0.0",
  "description": "IP-XACT import / export package",
  "author": "SiFive",
  "license": "Apache-2.0",
  "main": "lib/index.js",
  "bin": {
    "duh-ipxact": "dist/duh-ipxact.js"
  },
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "build": "node build.js",
    "lint": "eslint lib bin",
    "test": "eslint lib bin && c8 -r=text -r=lcov mocha test",
    "prepublishOnly": "npm run build",
    "fetch": "node bin/duh-ipxact.js fetch",
    "xsd": "node bin/xsd-tables.js",
    "zoo:survey": "node bin/zoo-survey.js",
    "zoo:check": "node bin/zoo-check.js",
    "zoo:update": "UPDATE_ZOO=1 c8 mocha test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sifive/duh-ipxact.git"
  },
  "files": [
    "bin",
    "lib",
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "bugs": {
    "url": "https://github.com/sifive/duh-ipxact/issues"
  },
  "homepage": "https://github.com/sifive/duh-ipxact#readme",
  "dependencies": {
    "ajv": "^8.20.0",
    "duh-core": "^1.0.0",
    "duh-schema": "^1.0.0",
    "json5": "^2.2.1",
    "onml": "^2.3.0"
  },
  "devDependencies": {
    "@drom/eslint-config": "^1.0.0",
    "c8": "^12.0.0",
    "chai": "^6.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.0.0",
    "globals": "^17.14.0",
    "mocha": "^12.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
